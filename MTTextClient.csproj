<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MTTextClient</RootNamespace>
  </PropertyGroup>

  <!-- Test sources live in their own project under tests/, and the generator
       helpers under tools/. Without these excludes, the SDK's default glob
       pulls every *.cs in the repo into the main assembly, which then
       conflicts with the generators' own Main entry points. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Content Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
  </ItemGroup>

  <!-- Vendor references and acquisition are shared in Directory.Build.targets. -->

  <!-- Vendored algoConfigs.json template file.
       mt_algos_create is clone-from-existing only: it scans the target
       AlgoStore for a matching group_type and clones from there. On a
       freshly-provisioned bench with zero algos loaded there is nothing
       to clone, so we ship a starter template file the helper can fall
       back to.

       templates/algoConfigs.json — 5 canonical algorithm templates (one
       per group_type: SG=Shots, AG=Averages, MW=Markets Watcher,
       MS=Markets Saver, VG=Vector Group), derived from a known-good
       algorithms.config with profile-specific IDs and names sanitized
       to generic labels. Copied flat into the build output so
       mt_import_templates finds it at AppContext.BaseDirectory on
       first call, with no per-user setup required. -->
  <ItemGroup>
    <Content Include="templates/algoConfigs.json">
      <Link>algorithms.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="templates/algoConfigs.json">
      <Link>algoConfigs.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- BouncyCastle.Cryptography is the AES256 implementation that
         MTShared.dll's wire-protocol crypto path resolves to at runtime.
         Pinning explicitly here:
           (a) makes NuGet copy the DLL into bin/<config>/net8.0/ on every
               build, regardless of whether a transitive consumer touches it;
           (b) locks the version to 2.0.0 so a transitive bump can't drift
               the cipher implementation underneath us;
           (c) provides a single declaration point so security advisory
               review is concentrated on one line of the manifest.
         The Static test in tests/MTTextClient.Tests/Static/BouncyCastleVersionPinTests.cs
         asserts the runtime-loaded version matches 2.0.0. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.0.0" />
  </ItemGroup>

</Project>
