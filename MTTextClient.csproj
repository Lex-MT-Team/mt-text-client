<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MTTextClient</RootNamespace>
  </PropertyGroup>

  <!-- Test sources live in their own project under tests/, and the generator
       helpers under tools/. Without these excludes, the SDK's default glob
       pulls every *.cs in the repo into the main assembly, which then
       conflicts with the generators' own Main entry points. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Content Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
  </ItemGroup>

  <!-- Vendor-lib resolution.
       The MTShared.dll / LiteNetLib.dll referenced below come from the
       published MoonTrader build. They are platform-dependent (different
       SHA per RID even for the same vendor version), so the project ships
       a small download-at-build helper (scripts/fetch_vendor_libs.py) that
       fetches the right tarball for the host RID, verifies it against the
       vendor's SHA-256 manifest, and extracts the two DLLs into
       lib/<rid>/.
       The HintPath below prefers lib/<rid>/<dll> when present, falling
       back to the committed lib/<dll> baseline. See lib/README.md. -->
  <Choose>
    <When Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">
      <PropertyGroup><MTCoreVendorRid>osx-arm64</MTCoreVendorRid></PropertyGroup>
    </When>
    <When Condition="$([MSBuild]::IsOSPlatform('OSX'))">
      <PropertyGroup><MTCoreVendorRid>osx-x64</MTCoreVendorRid></PropertyGroup>
    </When>
    <When Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">
      <PropertyGroup><MTCoreVendorRid>linux-arm64</MTCoreVendorRid></PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup><MTCoreVendorRid>linux-x64</MTCoreVendorRid></PropertyGroup>
    </Otherwise>
  </Choose>

  <PropertyGroup>
    <_MTSharedRidPath>$(MSBuildThisFileDirectory)lib/$(MTCoreVendorRid)/MTShared.dll</_MTSharedRidPath>
    <_LiteNetLibRidPath>$(MSBuildThisFileDirectory)lib/$(MTCoreVendorRid)/LiteNetLib.dll</_LiteNetLibRidPath>
    <_MTSharedLegacyPath>$(MSBuildThisFileDirectory)lib/MTShared.dll</_MTSharedLegacyPath>
    <_LiteNetLibLegacyPath>$(MSBuildThisFileDirectory)lib/LiteNetLib.dll</_LiteNetLibLegacyPath>
    <!-- Resolution order: legacy committed file wins when present, RID copy
         is the fallback. The committed lib/MTShared.dll is the active
         API surface the code is compiled against; the RID-specific copy
         (produced by scripts/fetch_vendor_libs.py from the latest vendor
         build) is the migration target. When mt-text-client's wire layer
         is upgraded to track the latest vendor MTShared.dll, the legacy
         file will be removed from the repo and the RID copy becomes the
         single source of truth. -->
    <MTSharedHintPath Condition="Exists('$(_MTSharedLegacyPath)')">$(_MTSharedLegacyPath)</MTSharedHintPath>
    <MTSharedHintPath Condition="'$(MTSharedHintPath)' == '' AND Exists('$(_MTSharedRidPath)')">$(_MTSharedRidPath)</MTSharedHintPath>
    <LiteNetLibHintPath Condition="Exists('$(_LiteNetLibLegacyPath)')">$(_LiteNetLibLegacyPath)</LiteNetLibHintPath>
    <LiteNetLibHintPath Condition="'$(LiteNetLibHintPath)' == '' AND Exists('$(_LiteNetLibRidPath)')">$(_LiteNetLibRidPath)</LiteNetLibHintPath>
    <!-- Force the vendor-fetch step even when a HintPath already resolves;
         useful for testing newer pinned vendor versions. -->
    <FetchVendorLibs Condition="'$(FetchVendorLibs)' == ''">false</FetchVendorLibs>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MTShared">
      <HintPath>$(MTSharedHintPath)</HintPath>
    </Reference>
    <Reference Include="LiteNetLib">
      <HintPath>$(LiteNetLibHintPath)</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Vendor-lib auto-fetch.
       Runs scripts/fetch_vendor_libs.py before reference resolution when:
         (a) neither lib/<rid>/MTShared.dll nor lib/MTShared.dll exists,
             i.e. the build has no fallback source, OR
         (b) -p:FetchVendorLibs=true was passed explicitly to refresh.
       The script downloads the right MoonTrader tarball for $(MTCoreVendorRid),
       verifies SHA-256 against the vendor manifest, extracts MTShared.dll
       and LiteNetLib.dll into lib/<rid>/, and applies the PE Machine-field
       patch on osx-arm64.  ContinueOnError so a missing python3 / offline
       host can still build against the committed baseline.  -->
  <Target Name="FetchVendorLibs"
          BeforeTargets="ResolveAssemblyReferences"
          Condition=" '$(FetchVendorLibs)' == 'true' OR (!Exists('$(_MTSharedRidPath)') AND !Exists('$(_MTSharedLegacyPath)')) ">
    <Message Importance="high"
             Text="[FetchVendorLibs] running scripts/fetch_vendor_libs.py --rid $(MTCoreVendorRid)" />
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)scripts/fetch_vendor_libs.py&quot; --rid $(MTCoreVendorRid)"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- Vendored algorithm template JSON file.
       The vendor mtclient UI has no "create from scratch" code path for
       algorithms — every algo creation in the vendor UI clones from
       an existing AlgorithmData (see DLT.UIVisualElement.AlgorithmDialogVE
       and DLT.UIVisualElement.QuickAlgoStartManagerVE). Templates live in
       a config file shipped with the desktop client distribution.

       We ship the equivalent at templates/algoConfigs.json — 5 canonical
       algorithm templates (one per group_type: SG=Shots, AG=Averages,
       MW=Markets Watcher, MS=Markets Saver, VG=Vector Group), derived
       mechanically from a known-good bench algorithms.config (operator-
       specific IDs and names sanitized to generic labels). Copied into
       the build output under both algorithms.json (current operator
       convention) and algoConfigs.json (legacy client convention), so
       mt_import_templates finds it at AppContext.BaseDirectory on first
       call, with no operator setup. -->
  <ItemGroup>
    <Content Include="templates/algoConfigs.json">
      <Link>algorithms.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="templates/algoConfigs.json">
      <Link>algoConfigs.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- BouncyCastle.Cryptography is the AES256 implementation that
         lib/MTShared.dll's wire-protocol crypto path resolves to at runtime.
         Pinning explicitly here:
           (a) makes NuGet copy the DLL into bin/<config>/net8.0/ on every
               build, regardless of whether a transitive consumer touches it;
           (b) locks the version to 2.0.0 so a transitive bump can't drift
               the cipher implementation underneath us;
           (c) provides a single declaration point so security advisory
               review is concentrated on one line of the manifest.
         The Static test in tests/MTTextClient.Tests/Static/BouncyCastleVersionPinTests.cs
         asserts the runtime-loaded version matches 2.0.0. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.0.0" />
  </ItemGroup>

</Project>
