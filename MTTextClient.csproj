<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MTTextClient</RootNamespace>
  </PropertyGroup>

  <!-- Test sources live in their own project under tests/, and the Stage 0.3
       generator helpers under tools/. Without these excludes, the SDK's
       default glob pulls every <c>*.cs</c> in the repo into the main assembly,
       which then conflicts with the generators' own Main entry points. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Content Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MTShared">
      <HintPath>lib/MTShared.dll</HintPath>
    </Reference>
    <Reference Include="LiteNetLib">
      <HintPath>lib/LiteNetLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Stage 0.6 — Apple Silicon build hygiene.
       Vendor ships lib/MTShared.dll built for x64 (Machine=0x8664). Under
       Apple Silicon the .NET 8 CLR refuses to load that as a native dep.
       scripts/patch_mtshared_arm64.py flips the PE Machine field to
       ARM64 (0xAA64); the managed IL is AnyCPU so it runs fine after JIT.
       Repo ships lib/MTShared.dll already patched. This target re-runs
       the script after every build as a safety net: if anyone refreshes
       MTShared.dll from the vendor (which re-introduces 0x8664), the
       next build flips it back. Idempotent. On Linux / Windows the
       condition is false and the target is a no-op. -->
  <Target Name="PatchMTSharedArm64"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)scripts/patch_mtshared_arm64.py&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Stage 0.5 pin (UnifiedDevelopmentPlan §6, decision in §12.1):
         BouncyCastle.Cryptography is the AES256 implementation referenced by
         lib/MTShared.dll's wire-protocol crypto path. Before this pin it was
         an implicit transitive dep — MTShared.dll's metadata named the
         assembly, but no copy was guaranteed under bin/Release/net8.0/. That
         meant any future NuGet resolution could silently substitute a
         different patched version OR omit it entirely until MTShared exercised
         the crypto path (which Smoke does NOT — connect handshake takes the
         path that loads BouncyCastle types). Pinning explicitly here:
           (a) makes NuGet copy the DLL into bin/ on every build,
           (b) locks the version to 2.0.0 so a transitive bump can't drift
               the cipher implementation under our feet,
           (c) provides a single declaration point for the advisory review
               that the plan §12.1 calls for (advisories noted; revisit).
         The Static test in tests/.../Static/BouncyCastleVersionPinTests.cs
         asserts the runtime-loaded version matches 2.0.0. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.0.0" />
  </ItemGroup>

</Project>
