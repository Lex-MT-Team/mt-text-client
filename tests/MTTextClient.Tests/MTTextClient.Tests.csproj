<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MTTextClient.Tests</RootNamespace>
    <!-- Smoke + Integration tests still drive the built MCP binary as a stdio
         subprocess (see McpFixture). Static tests also call the registry +
         dispatcher in-process via the ProjectReference below; that's how
         DispatcherSnapshotTests / ReadmeParityTests assert byte-equivalence
         against the committed snapshot and README. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.5" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MTTextClient.csproj" />
    <ProjectReference Include="..\..\tools\RegistryReadmeGenerator\RegistryReadmeGenerator.csproj" />
    <ProjectReference Include="..\..\tools\DispatcherSnapshotGenerator\DispatcherSnapshotGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct vendor reference so unit tests can construct MTShared wire
         types. Forward slashes: backslash-relative HintPaths resolve on
         Windows/macOS but break copy-local on Linux. Private=true forces
         the DLL into the test output on every platform. -->
    <Reference Include="MTShared">
      <HintPath>$(MSBuildThisFileDirectory)../../lib/MTShared.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- The committed lib/MTShared.dll carries PE Machine=ARM64 (Apple
       Silicon hosts load it natively); the CLR on linux-x64 rejects that
       header while probing, so the test-output copy is flipped back to
       x64 after every Linux build. See the matching target in
       MTTextClient.csproj. -->
  <Target Name="PatchTestMTSharedMachineLinux"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)../../scripts/patch_mtshared_arm64.py&quot; --machine x64 &quot;$(TargetDir)MTShared.dll&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <ItemGroup>
    <None Update="_expected\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
