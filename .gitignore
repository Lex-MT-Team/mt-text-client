# Build output
bin/
obj/

# IDE / editor
.vs/
.vscode/
*.user
*.suo

# Debug symbols (keep in build, not in repo)
*.pdb

# Backup files
*.bak
*.orig
*.tmp

# OS files
.DS_Store
Thumbs.db

# Profile data (contains connection tokens)
profiles.json

# Stage 0.6 — test results are generated artefacts; never commit them.
*.trx
TestResults/

# Local worktree/agent scaffolding — never committed.
.claude/

# Per-developer MCP server config — gitignored so each contributor's
# local toolchain (codegraph, etc.) stays private.
.mcp.json

# Local code-intelligence index — machine-specific SQLite graph,
# may be referenced cross-project via the codegraph projectPath argument.
.codegraph/
